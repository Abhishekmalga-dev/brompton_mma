{
  "Comment": "Sentiment Glue Job -> Curation Glue Job -> Comprehend Pipeline (sequential), with unified failure notification",
  "StartAt": "StartSentimentGlueJob",
  "States": {
    "StartSentimentGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "datalake-sentiment-analysis-dev",
        "Arguments": {
          "--mode": "auto"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckSentimentStatus"
    },
    "CheckSentimentStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.JobRunState",
          "StringEquals": "SUCCEEDED",
          "Next": "StartCurationGlueJob"
        }
      ],
      "Default": "NotifyFailure"
    },
    "StartCurationGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "datalake-sentiment-analysis-curation-dev",
        "Arguments": {
          "--mode": "auto"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckCurationStatus"
    },
    "CheckCurationStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.JobRunState",
          "StringEquals": "SUCCEEDED",
          "Next": "GetSourceAvailability"
        }
      ],
      "Default": "NotifyFailure"
    },
    "GetSourceAvailability": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "datalake-sentiment-analysis-get-availability-dev",
        "Payload": {}
      },
      "ResultPath": "$.availability_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckSMSRelationalAvailability"
    },
    "CheckSMSRelationalAvailability": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.availability_result.Payload.sms_web_relational_available",
              "IsPresent": true
            },
            {
              "Variable": "$.availability_result.Payload.sms_web_relational_available",
              "BooleanEquals": true
            }
          ],
          "Next": "StartComprehendJob_SMSRelational"
        }
      ],
      "Default": "CheckSMSTransactionalAvailability"
    },
    "StartComprehendJob_SMSRelational": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:us-east-1:053234861925:stateMachine:datalake-comprehend-pipeline-temp-dev",
        "Input": {
          "load_mode": "APPEND_MISSING",
          "dates": [],
          "update_rds": true,
          "create_endpoints": true,
          "delete_endpoints": false,
          "source": "sms_web_relational",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.comprehend_pipeline_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckComprehendStatus_SMSRelational"
    },
    "CheckComprehendStatus_SMSRelational": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.comprehend_pipeline_result.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "CheckSMSTransactionalAvailability"
        }
      ],
      "Default": "NotifyFailure"
    },
    "CheckSMSTransactionalAvailability": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.availability_result.Payload.sms_web_transactional_available",
              "IsPresent": true
            },
            {
              "Variable": "$.availability_result.Payload.sms_web_transactional_available",
              "BooleanEquals": true
            }
          ],
          "Next": "StartComprehendJob_SMSTransactional"
        }
      ],
      "Default": "StartComprehendJob_IVR"
    },
    "StartComprehendJob_SMSTransactional": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:us-east-1:053234861925:stateMachine:datalake-comprehend-pipeline-temp-dev",
        "Input": {
          "load_mode": "APPEND_MISSING",
          "dates": [],
          "update_rds": true,
          "create_endpoints": true,
          "delete_endpoints": false,
          "source": "sms_web_transactional",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.comprehend_pipeline_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckComprehendStatus_SMSTransactional"
    },
    "CheckComprehendStatus_SMSTransactional": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.comprehend_pipeline_result.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "StartComprehendJob_IVR"
        }
      ],
      "Default": "NotifyFailure"
    },
    "StartComprehendJob_IVR": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:us-east-1:053234861925:stateMachine:datalake-comprehend-pipeline-temp-dev",
        "Input": {
          "load_mode": "APPEND_MISSING",
          "dates": [],
          "update_rds": true,
          "create_endpoints": true,
          "delete_endpoints": true,
          "source": "ivr",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.comprehend_pipeline_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckComprehendStatus_IVR"
    },
    "CheckComprehendStatus_IVR": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.comprehend_pipeline_result.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "Success"
        }
      ],
      "Default": "NotifyFailure"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:053234861925:datalake-sentiment-analysis-alerts-dev",
        "Subject": "ALERT: Sentiment/Curation/Comprehend Pipeline Failure",
        "Message": "A step in the sentiment/curation/comprehend pipeline FAILED in dev. Check the Step Functions execution history for details."
      },
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail",
      "Error": "PipelineExecutionFailed",
      "Cause": "One or more steps in the sentiment/curation/comprehend pipeline failed. See NotifyFailure SNS alert and execution history for details."
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}