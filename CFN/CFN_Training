AWSTemplateFormatVersion: '2010-09-09'
Description: >
  Comprehend Model Training/Eval Pipeline - separate stack from the daily-use
  sentiment analysis pipeline (sentiment_analysis_stack.yml) so this can be
  modified/redeployed independently. Triggered fire-and-forget (no .sync, no
  Catch) by the daily pipeline's TriggerTrainingEval state, which passes
  run_id/train_mode/test_mode/data_access_role_arn as execution Input - none
  of those are CloudFormation Parameters here, they arrive at runtime.

Parameters:

  DeployEnv:
    Type: String
    Description: "Deployment environment. dev and staging both deploy into the nonprod AWS account as fully independent, parallel stacks."
    AllowedValues:
      - dev
      - staging
      - prod

  # --- Existing S3 buckets (NOT created by this template) ---

  ArtifactBucket:
    Type: String
    Description: "Existing S3 bucket where CI/CD uploads this pipeline's Lambda zips."
    Default: psegli-datalakenonprodli-datalake-build-dev

  TempBucketName:
    Type: String
    Description: "Existing S3 bucket used for training data (Sentiment_Analysis/training_data/...). Shared/pinned, not replicated per DeployEnv - same bucket the daily pipeline uses."
    Default: psegli-datalakenonprodli-datalake-temp-dev

  # --- Existing shared IAM roles (NOT created by this template) ---
  # PLACEHOLDER - flagged as the LAST open item, per explicit instruction:
  # user will confirm tomorrow whether Comprehend training Lambdas need
  # broader/different IAM permissions (e.g. comprehend:CreateDocumentClassifier)
  # than the daily-pipeline's shared roles. Using the SAME shared roles as a
  # starting assumption.

  LambdaExecutionRoleName:
    Type: String
    Description: "PLACEHOLDER - pending confirmation. Existing shared IAM role name for Lambda execution."
    Default: Lambda-execution-datalake-dev

  StepFunctionExecutionRoleName:
    Type: String
    Description: "PLACEHOLDER - pending confirmation. Existing shared IAM role name for Step Functions execution."
    Default: stepfunction-execution-datalake-dev

  # --- Versioning / artifacts ---

  CodeVersion:
    Type: String
    Description: "Short git SHA or version identifier for artifacts, matching the CI/CD packaging convention."
    Default: latest

  TrainingArtifactPrefix:
    Type: String
    Description: "S3 key prefix (within ArtifactBucket) where CI/CD uploads this pipeline's Lambda zips. FLAGGING proposed default - please confirm or correct, not yet screenshot-confirmed like sentiment-artifact was."
    Default: training-artifact

Conditions:

  IsProd: !Equals [!Ref DeployEnv, "prod"]

Mappings:

  # StagingArg has no consumer here today (no Glue jobs in this pipeline) -
  # ResourceSuffix is the one actually used, for every resource name below.
  EnvConfig:
    dev:
      AccountTier: nonprod
      StagingArg: "dev"
      ResourceSuffix: "dev"
    staging:
      AccountTier: nonprod
      StagingArg: "staging"
      ResourceSuffix: "staging-dev"
    prod:
      AccountTier: prod
      StagingArg: "dev"
      ResourceSuffix: "prod"

Resources:

  # --- Lambda Functions (11 total) ---
  # Runtime/Timeout/MemorySize/EphemeralStorage confirmed same as the daily
  # pipeline's 13 Lambdas. Handler convention (python.<filename>.lambda_handler)
  # assumed consistent with the same repo's folder structure - not individually
  # re-screenshotted per training Lambda, but matches the confirmed pattern.

  ComprehendTrainActionableLambda:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub
        - "datalake-comprehend-train-actionable-${Suffix}"
        - Suffix: !FindInMap [EnvConfig, !Ref DeployEnv, ResourceSuffix]
      Role: !Sub "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${LambdaExecutionRoleName}"
      Handler: python.datalake-comprehend-train-actionable.lambda_handler
      Runtime: python3.13
      Timeout: 421
      MemorySize: 10240
      EphemeralStorage:
        Size: 10240
      Code:
        S3Bucket: !Ref ArtifactBucket
        S3Key: !Sub
          - "${TrainingArtifactPrefix}/datalake-comprehend-train-actionable_${CodeVersion}_${EnvToken}.zip"
          - EnvToken: !If [IsProd, "prod", "dev"]
      Environment:
        Variables:
          ENV: !If [IsProd, "prod", "dev"]

