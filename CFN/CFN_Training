  # --- Step Function ---
  # IMPORTANT: this name MUST exactly match what the daily pipeline's
  # sentiment_analysis_stack.yml TrainingPipelineArn:
  # "datalake-comprehend-training-temp-${ResourceSuffix}". 

  ComprehendTrainingStateMachine:
    Type: AWS::StepFunctions::StateMachine
    Properties:
      StateMachineName: !Sub
        - "datalake-comprehend-training-temp-${Suffix}"
        - Suffix: !FindInMap [EnvConfig, !Ref DeployEnv, ResourceSuffix]
      RoleArn: !Sub "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${StepFunctionExecutionRoleName}"
      StateMachineType: STANDARD
      DefinitionString: !Sub
        - |
          {
            "Comment": "Comprehend training workflow: update training data first, train models in parallel, then write final training summary output.",
            "StartAt": "GenerateRuntimeParts",
            "States": {
              "GenerateRuntimeParts": {
                "Type": "Pass",
                "Parameters": {
                  "execution_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)",
                  "execution_time_raw.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 1)"
                },
                "ResultPath": "$.runtime_parts",
                "Next": "SplitRuntimeTime"
              },
              "SplitRuntimeTime": {
                "Type": "Pass",
                "Parameters": {
                  "execution_date.$": "$.runtime_parts.execution_date",
                  "time_parts.$": "States.StringSplit($.runtime_parts.execution_time_raw, '.:Z')"
                },
                "ResultPath": "$.runtime_parts",
                "Next": "GeneratePipelineConfig"
              },
              "GeneratePipelineConfig": {
                "Type": "Pass",
                "Parameters": {
                  "run_id.$": "States.Format('step-training-{}-{}-{}-{}', $.runtime_parts.execution_date, States.ArrayGetItem($.runtime_parts.time_parts, 1), States.ArrayGetItem($.runtime_parts.time_parts, 0), States.ArrayGetItem($.runtime_parts.time_parts, 2))",
                  "train_mode.$": "$.train_mode",
                  "test_mode.$": "$.test_mode",
                  "include_synthetic_training": {
                    "level2": true,
                    "level3": true,
                    "level4": true,
                    "actionable": false,
                    "urgent": false
                  },
                  "data_access_role_arn.$": "$.data_access_role_arn",
                  "level2_mode": "train",
                  "level3_mode": "train",
                  "level4_mode": "train",
                  "actionable_mode": "train",
                  "urgent_mode": "train",
                  "level2_classifier_name": "level2-custom-classifier",
                  "level3_classifier_name": "level3-custom-classifier",
                  "level4_classifier_name": "level4-custom-classifier",
                  "actionable_classifier_name": "actionable-custom-classifier",
                  "urgent_classifier_name": "urgent-custom-classifier"
                },
                "ResultPath": "$.config",
                "Next": "UpdateTrainingData"
              },
              "UpdateTrainingData": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "${UpdateTrainDataFunctionName}",
                  "Payload": {
                    "bucket": "${TempBucketName}",
                    "training_key": "Sentiment_Analysis/training_data/comprehend_training_with_headers.csv",
                    "corrected_key": "Sentiment_Analysis/training_data/corrected_final_output.csv",
                    "merged_output_key": "Sentiment_Analysis/training_data/comprehend_training_with_headers_merged.csv",
                    "test_mode.$": "$.config.test_mode",
                    "include_synthetic_training.$": "$.config.include_synthetic_training",
                    "min_text_length": 3,
                    "level2_classifier_name.$": "$.config.level2_classifier_name",
                    "level3_classifier_name.$": "$.config.level3_classifier_name",
                    "level4_classifier_name.$": "$.config.level4_classifier_name",
                    "urgent_classifier_name.$": "$.config.urgent_classifier_name",
                    "actionable_classifier_name.$": "$.config.actionable_classifier_name"
                  }
                },
                "ResultSelector": {
                  "statusCode.$": "$.StatusCode",
                  "payload.$": "$.Payload"
                },
                "ResultPath": "$.update_training_data_result",
                "Retry": [
                  {
                    "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                    "IntervalSeconds": 5,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                  }
                ],
                "Next": "CheckTrainingGate"
              },
              "CheckTrainingGate": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "${ComprehendTrainGateFunctionName}",
                  "Payload": {
                    "train_mode.$": "$.config.train_mode",
                    "training_bucket": "${TempBucketName}",
                    "training_baseline_key": "Sentiment_Analysis/training_data/training_summaries/training_record_baseline.json",
                    "corrected_final_output_key": "Sentiment_Analysis/training_data/corrected_final_output.csv",
                    "min_new_records_for_training": 100
                  }
                },
                "ResultSelector": {
                  "should_train.$": "$.Payload.training_gate.should_train",
                  "instruction.$": "$.Payload.training_gate.instruction",
                  "current_record_count.$": "$.Payload.training_gate.current_record_count",
                  "last_trained_record_count.$": "$.Payload.training_gate.last_trained_record_count",
                  "new_records_since_training.$": "$.Payload.training_gate.new_records_since_training",
                  "min_new_records_for_training.$": "$.Payload.training_gate.min_new_records_for_training",
                  "checked_at.$": "$.Payload.training_gate.checked_at",
                  "baseline_key.$": "$.Payload.training_gate.baseline_key",
                  "corrected_final_output_key.$": "$.Payload.training_gate.corrected_final_output_key"
                },
                "ResultPath": "$.training_gate",
                "Next": "ShouldTrainModels"
              },
              "ShouldTrainModels": {
                "Type": "Choice",
                "Choices": [
                  {
                    "Variable": "$.training_gate.instruction",
                    "StringEquals": "CONTINUE",
                    "Next": "TrainModelsInParallel"
                  }
                ],
                "Default": "SkipTraining"
              },
              "SkipTraining": {
                "Type": "Succeed"
              },
              "TrainModelsInParallel": {
                "Type": "Parallel",
                "Branches": [
                  {
                    "StartAt": "TrainLevel2Classifier",
                    "States": {
                      "TrainLevel2Classifier": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainLevel2FunctionName}",
                          "Payload": {
                            "mode.$": "$.config.level2_mode",
                            "test_mode.$": "$.config.test_mode",
                            "run_id.$": "$.config.run_id",
                            "data_access_role_arn.$": "$.config.data_access_role_arn",
                            "classifier_name.$": "$.config.level2_classifier_name",
                            "version_name.$": "$.update_training_data_result.payload.latest_model_versions.level2_custom_classifier"
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.level2_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  },
                  {
                    "StartAt": "TrainLevel3Discovery",
                    "States": {
                      "TrainLevel3Discovery": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainLevel3FunctionName}",
                          "Payload": {
                            "run_id.$": "$.config.run_id",
                            "mode.$": "$.config.level3_mode",
                            "seed_training_s3_uri": "${TrainingSeedS3Uri}",
                            "artifact_s3_uri": "${Level3ArtifactS3Uri}",
                            "append_run_id": false,
                            "verbose": true
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.level3_discovery_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  },
                  {
                    "StartAt": "TrainLevel3Classifier",
                    "States": {
                      "TrainLevel3Classifier": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainLevel3ClassifierFunctionName}",
                          "Payload": {
                            "mode.$": "$.config.level3_mode",
                            "test_mode.$": "$.config.test_mode",
                            "run_id.$": "$.config.run_id",
                            "data_access_role_arn.$": "$.config.data_access_role_arn",
                            "classifier_name.$": "$.config.level3_classifier_name",
                            "version_name.$": "$.update_training_data_result.payload.latest_model_versions.level3_custom_classifier"
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.level3_classifier_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  },
                  {
                    "StartAt": "TrainLevel4Classifier",
                    "States": {
                      "TrainLevel4Classifier": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainLevel4FunctionName}",
                          "Payload": {
                            "mode.$": "$.config.level4_mode",
                            "test_mode.$": "$.config.test_mode",
                            "run_id.$": "$.config.run_id",
                            "data_access_role_arn.$": "$.config.data_access_role_arn",
                            "classifier_name.$": "$.config.level4_classifier_name",
                            "version_name.$": "$.update_training_data_result.payload.latest_model_versions.level4_custom_classifier"
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.level4_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  },
                  {
                    "StartAt": "TrainUrgentClassifier",
                    "States": {
                      "TrainUrgentClassifier": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainUrgentFunctionName}",
                          "Payload": {
                            "mode.$": "$.config.urgent_mode",
                            "test_mode.$": "$.config.test_mode",
                            "run_id.$": "$.config.run_id",
                            "data_access_role_arn.$": "$.config.data_access_role_arn",
                            "classifier_name.$": "$.config.urgent_classifier_name",
                            "version_name.$": "$.update_training_data_result.payload.latest_model_versions.urgent_custom_classifier"
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.urgent_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  },
                  {
                    "StartAt": "TrainActionableClassifier",
                    "States": {
                      "TrainActionableClassifier": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::lambda:invoke",
                        "Parameters": {
                          "FunctionName": "${ComprehendTrainActionableFunctionName}",
                          "Payload": {
                            "mode.$": "$.config.actionable_mode",
                            "test_mode.$": "$.config.test_mode",
                            "run_id.$": "$.config.run_id",
                            "data_access_role_arn.$": "$.config.data_access_role_arn",
                            "classifier_name.$": "$.config.actionable_classifier_name",
                            "version_name.$": "$.update_training_data_result.payload.latest_model_versions.actionable_custom_classifier"
                          }
                        },
                        "ResultSelector": {
                          "statusCode.$": "$.StatusCode",
                          "payload.$": "$.Payload"
                        },
                        "ResultPath": "$.actionable_training_result",
                        "Retry": [
                          {
                            "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                            "IntervalSeconds": 5,
                            "MaxAttempts": 3,
                            "BackoffRate": 2
                          }
                        ],
                        "End": true
                      }
                    }
                  }
                ],
                "ResultPath": "$.parallel_training_results",
                "Next": "ValidateTrainingResults"
              },
              "ValidateTrainingResults": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "${ComprehendTrainValidateOutputFunctionName}",
                  "Payload.$": "$"
                },
                "ResultSelector": {
                  "statusCode.$": "$.StatusCode",
                  "payload.$": "$.Payload"
                },
                "ResultPath": "$.validate_training_results_result",
                "Retry": [
                  {
                    "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                    "IntervalSeconds": 5,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                  }
                ],
                "Next": "CreateFinalTrainingOutput"
              },
              "CreateFinalTrainingOutput": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "${ComprehendTrainFinalOutputFunctionName}",
                  "Payload.$": "$.validate_training_results_result.payload.training_results"
                },
                "ResultSelector": {
                  "statusCode.$": "$.StatusCode",
                  "payload.$": "$.Payload"
                },
                "ResultPath": "$.final_training_output_result",
                "Retry": [
                  {
                    "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                    "IntervalSeconds": 5,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                  }
                ],
                "Next": "UpdateTrainingBaseline"
              },
              "UpdateTrainingBaseline": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "${ComprehendTrainUpdateBaselineFunctionName}",
                  "Payload.$": "$"
                },
                "ResultSelector": {
                  "statusCode.$": "$.StatusCode",
                  "payload.$": "$.Payload"
                },
                "ResultPath": "$.update_training_baseline_result",
                "Retry": [
                  {
                    "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                    "IntervalSeconds": 5,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                  }
                ],
                "End": true
              }
            }
          }
